# Local development — copy to .env and adjust as needed.
# With Docker Compose: run `docker compose up` then use localhost below.

MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=youthstore
MYSQL_PORT=3307
APP_PORT=3000

DATABASE_URL=mysql://root@localhost:3307/youthstore
JWT_SECRET=change-me-in-production
ADMIN_EMAIL=admin@malikatabayat.local
ADMIN_PASSWORD=admin123

# Optional persistent image directory. Production defaults to
# $HOME/.malikat-abayat/uploads/p when this is not set.
# UPLOAD_STORAGE_DIR=/absolute/path/to/uploads/p

# Active shipping provider (server-side). Default: sendit
# Supported: sendit | olivraison
SHIPPING_PROVIDER=sendit

# Sendit API (server-side only — Settings → API integrations in Sendit)
# Public + secret keys → POST /login → Bearer JWT
SENDIT_PUBLIC_KEY=
SENDIT_SECRET_KEY=
SENDIT_API_BASE_URL=https://app.sendit.ma/api/v1
# Optional webhook endpoint gate (recommended). Configure the same secret in
# the Sendit dashboard callback URL (?secret=…) or custom header if supported.
# SENDIT_WEBHOOK_SECRET=

# Olivraison Partners API (legacy fallback when SHIPPING_PROVIDER=olivraison)
OLIVRAISON_API_KEY=
OLIVRAISON_SECRET_KEY=
OLIVRAISON_BASE_URL=https://partners.olivraison.com

# Meta Pixel (storefront; required for Pixel). Optional META_PIXEL_ID overrides server-side.
NEXT_PUBLIC_META_PIXEL_ID=
# META_PIXEL_ID=

# Meta Conversions API (server-side only — never expose to the browser)
META_CAPI_ACCESS_TOKEN=
# Optional during testing in Meta Events Manager → Test Events
# META_CAPI_TEST_EVENT_CODE=

# Optional: run `npm run build` without a database (migrations/seed skipped)
# DATABASE_URL=

# Optional seed controls (used by scripts/deploy-db.cjs during build)
# FORCE_SEED=1
# SKIP_SEED=1
