generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(100)
  nameAr    String?  @db.VarChar(255)
  nameFr    String?  @db.VarChar(255)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("categories")
}

model Product {
  id             String   @id @default(cuid())
  name           String
  nameAr         String?  @db.VarChar(255)
  nameFr         String?  @db.VarChar(255)
  sku            String?  @unique @db.VarChar(100)
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  stockQuantity  Int?
  soldCount      Int      @default(0)
  rating         Decimal? @db.Decimal(2, 1)
  reviewCount    Int      @default(0)
  description    String   @db.Text
  descriptionAr  String?  @db.Text
  descriptionFr  String?  @db.Text
  categories     Json
  images         Json
  colorVariants  Json
  bundleOffers   Json?
  availableSizes Json?
  detailContent  Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders         Order[]

  @@map("products")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("admin_users")
}

model HomeSection {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(50)
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("home_sections")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

model Order {
  id                    String      @id @default(cuid())
  customerName          String
  phone                 String
  city                  String
  selectedColor         String?
  quantity              Int         @default(1)
  totalPrice            Decimal     @db.Decimal(10, 2)
  lineItems             Json?
  productId             String
  product               Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  status                OrderStatus @default(PENDING)
  statusNote            String?     @db.Text
  statusUpdatedAt       DateTime?
  streetAddress         String?     @db.VarChar(500)
  shippingComment       String?     @db.VarChar(500)
  shippingDescription   String?     @db.VarChar(500)
  shippingNoOpen        Boolean     @default(false)
  olivraisonTrackingId  String?     @db.VarChar(100)
  /// Active / historical provider id: "sendit" | "olivraison"
  shippingProvider      String?     @db.VarChar(32)
  /// Provider tracking / parcel code (Sendit `code`, Olivraison tracking ID, …)
  shippingTrackingId    String?     @db.VarChar(100)
  shippedAt             DateTime?
  metaFbp               String?     @db.VarChar(255)
  metaFbc               String?     @db.VarChar(512)
  utmSource             String?     @db.VarChar(120)
  utmMedium             String?     @db.VarChar(120)
  utmCampaign           String?     @db.VarChar(180)
  utmContent            String?     @db.VarChar(180)
  utmTerm               String?     @db.VarChar(180)
  marketingConsent      Boolean?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  metaEventLogs         MetaEventLog[]

  @@index([productId])
  @@index([status])
  @@index([shippingTrackingId])
  @@index([shippingProvider])
  @@map("orders")
}

enum MetaEventLogStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// Server-side Meta/business analytics delivery log. No raw customer PII.
model MetaEventLog {
  id            String             @id @default(cuid())
  orderId       String
  order         Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventName     String             @db.VarChar(64)
  eventId       String             @db.VarChar(128)
  status        MetaEventLogStatus @default(PENDING)
  attemptCount  Int                @default(0)
  lastAttemptAt DateTime?
  sentAt        DateTime?
  errorCode     String?            @db.VarChar(120)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([orderId, eventName])
  @@index([eventId])
  @@index([status])
  @@map("meta_event_logs")
}

/// Additive storefront traffic counters only. Never write Order/Product/Meta data from this.
model SiteDailyMetric {
  id        String   @id @default(cuid())
  day       DateTime @db.Date
  pathType  String   @db.VarChar(32)
  productId String   @default("") @db.VarChar(64)
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([day, pathType, productId])
  @@index([day])
  @@map("site_daily_metrics")
}
